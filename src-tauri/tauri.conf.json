{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DownPilot",
  "version": "0.1.0",
  "identifier": "com.downpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../src run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DownPilot",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "High-performance download manager",
    "longDescription": "DownPilot is a high-performance, IDM-class download manager for Linux with chunked transfers, queues, scheduling, site rules, browser capture, and a site grabber.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "fileAssociations": [
      {
        "ext": ["dpl"],
        "name": "DownPilot Task List",
        "description": "DownPilot import file",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["downpilot"]
      }
    },
    "notification": null
  }
}
