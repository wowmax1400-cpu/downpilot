{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DownPilot",
  "version": "0.1.0",
  "identifier": "com.downpilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix src run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DownPilot",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "icon": ["icons/icon.png", "icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "High-performance download manager"
  }
}
